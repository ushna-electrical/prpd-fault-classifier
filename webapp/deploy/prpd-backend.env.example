# Copy to /opt/prpd/prpd-backend.env (referenced by prpd-backend.service) and
# fill in real values. All optional; see Code/webapp/main.py's module
# docstring for the full, authoritative list and defaults.

# Comma-separated list of origins allowed to call this API from a browser.
# Only needed for a SPLIT deployment (frontend on a different origin, e.g.
# Vercel); for a same-origin deployment (Nginx proxying /api/ to this process
# and serving the frontend itself) this can be left unset.
# PRPD_CORS_ORIGINS=https://your-app.vercel.app,https://prpd.yourdomain.com

# Only needed if the data folders aren't in their default location relative
# to Code/ (CODE_ROOT.parent/"Table 5.5" and CODE_ROOT/"stage2_output").
# PRPD_LIBRARY_IMAGES_DIR=/opt/prpd/Table 5.5
# PRPD_STAGE2_DIR=/opt/prpd/Code/stage2_output

# Set to 1 only if you want this FastAPI process to also serve the static
# frontend itself (no separate Nginx "location /" static block needed -- see
# DEPLOYMENT.md's "simplest" option). Leave unset if Nginx serves the
# frontend directly (the recommended, faster option).
# PRPD_SERVE_FRONTEND=1
# PRPD_FRONTEND_DIR=/opt/prpd/Code/webapp/frontend
