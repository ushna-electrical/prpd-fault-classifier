{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Backend: run (uvicorn)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": { "cwd": "${workspaceFolder}/webapp/backend" },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Frontend: serve static (port 5500)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "http.server", "5500"],
      "options": { "cwd": "${workspaceFolder}/.." },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Backend: run single-process (serves frontend too, for ngrok/sharing)",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "uvicorn", "app.main:app", "--reload", "--port", "8000"],
      "options": {
        "cwd": "${workspaceFolder}/webapp/backend",
        "env": { "PRPD_SERVE_FRONTEND": "1" }
      },
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "reveal": "always" }
    },
    {
      "label": "Backend: run tests",
      "type": "shell",
      "command": "${workspaceFolder}/.venv/Scripts/python.exe",
      "args": ["-m", "pytest", "tests/", "-v"],
      "options": { "cwd": "${workspaceFolder}/webapp/backend" },
      "problemMatcher": []
    },
    {
      "label": "Run full stack (backend + frontend)",
      "dependsOn": ["Backend: run (uvicorn)", "Frontend: serve static (port 5500)"],
      "dependsOrder": "parallel",
      "problemMatcher": []
    }
  ]
}
